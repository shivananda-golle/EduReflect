# ============================================================
# EduReflect — environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
# ============================================================

# ---- Hugging Face (LLM generation) ----
# Get a token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
GENERATOR_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Evidence truncation + LLM HTTP timeout (seconds)
MAX_EVIDENCE_CHARS=2000
REQUEST_TIMEOUT=120.0

# ---- Streamlit frontend ----
BACKEND_URL=http://localhost:8000
DEFAULT_API_TIMEOUT=30
LONG_API_TIMEOUT=300

# ---- Email (weekly quiz delivery) ----
# For Gmail, create an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=EduReflect

# ---- (Recommended) JWT secret ----
# Currently hard-coded in app/database/models.py; move it here in production.
# JWT_SECRET_KEY=replace-me-with-a-long-random-string
