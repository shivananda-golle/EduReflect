# ============================================================
# EduReflect — environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
# ============================================================

# ---- Hugging Face (LLM generation) ----
# Get a token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
GENERATOR_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Evidence truncation + LLM HTTP timeout (seconds)
MAX_EVIDENCE_CHARS=2000
REQUEST_TIMEOUT=120.0

# ---- Streamlit frontend ----
BACKEND_URL=http://localhost:8000
DEFAULT_API_TIMEOUT=30
LONG_API_TIMEOUT=300

# ---- Email (weekly quiz delivery) ----
# For Gmail, create an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=EduReflect

# ---- Security ----
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used per process (users are logged out on restart).
SECRET_KEY=

# Key required in the X-Admin-Key header for admin endpoints (email triggers).
# Leave empty to disable admin endpoints.
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Maximum upload size for document processing (MB).
MAX_UPLOAD_MB=10
