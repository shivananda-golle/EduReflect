# ============================================================
# EduReflect — environment configuration
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
# ============================================================

# ---- LLM (any OpenAI-compatible API; default is the Groq free tier) ----
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# Tried in order; the next one is used when a model is rate-limited.
LLM_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# When every model is rate-limited, wait up to this many seconds and retry once
LLM_MAX_RETRY_WAIT=10

# Evidence truncation + LLM HTTP timeout (seconds)
MAX_EVIDENCE_CHARS=4500
REQUEST_TIMEOUT=120.0

# ---- Free-tier protection ----
# LLM calls per day, all users combined
DAILY_LLM_CALL_LIMIT=500
# Questions/quizzes/summaries/uploads per user per day
USER_DAILY_ACTION_LIMIT=20
SIGNUPS_PER_IP_PER_HOUR=3
# Used instead when the visitor IP is unknown (hidden by a proxy)
SIGNUPS_PER_HOUR_GLOBAL=30
# Extra LLM call per question that rewrites it first; doubles usage when on
ENABLE_PROMPT_REWRITE=false

# ---- Streamlit frontend ----
BACKEND_URL=http://localhost:8000
DEFAULT_API_TIMEOUT=30
LONG_API_TIMEOUT=300

# ---- Email (weekly quiz delivery) ----
# For Gmail, create an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=EduReflect

# ---- Database ----
# Leave unset for a local SQLite file. Any SQLAlchemy URL works, e.g. a hosted Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Hosting ----
# Run the API inside the Streamlit process (for single-process hosts like Streamlit Community Cloud)
EMBEDDED_BACKEND=false
# Embedding model; must match the one used to build data/index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# dense | bm25 | hybrid | hybrid_rerank (see README > Evaluation)
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=10
# Public app URL used in emailed quiz links
APP_URL=http://localhost:8501

# ---- Security ----
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used per process (users are logged out on restart).
SECRET_KEY=

# Key required in the X-Admin-Key header for admin endpoints (email triggers).
# Leave empty to disable admin endpoints.
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Maximum upload size for document processing (MB).
MAX_UPLOAD_MB=10
